# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000

# Ruta de la base de datos
# En Railway: monta un volumen en /data y usa DB_PATH=/data/italiano.db
DB_PATH=./italiano.db

# API de IA (opcional — las funciones básicas funcionan sin esto)
# Acepta claves de OpenAI o Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Entorno
NODE_ENV=development
